# OKIRA Backend — Environment Variables
# Copy this file to .env and fill in your values

# ────────────────────────────
# App
# ────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production
API_V1_PREFIX=/api/v1

# ────────────────────────────
# Database (PostgreSQL)
# Use a cloud provider like Neon, Supabase, or Railway
# ────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/okira_db

# ────────────────────────────
# CORS — add your Vercel frontend URL
# ────────────────────────────
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ────────────────────────────
# JWT Auth
# ────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ────────────────────────────
# Email (Gmail App Password)
# Go to Google Account → Security → 2-Step Verification → App Passwords
# Generate a 16-character App Password and paste it below
# ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=OKIRA
ADMIN_EMAIL=your-admin-email@gmail.com

# ────────────────────────────
# Bank Details (shown at checkout)
# ────────────────────────────
BANK_ACCOUNT_TITLE=Muhammad Ahmad
BANK_NAME=Mashriq Bank
BANK_ACCOUNT_NUMBER=089010046367
BANK_IBAN=PK45MSHQ0000089010046367

# ────────────────────────────
# WhatsApp
# ────────────────────────────
STORE_WHATSAPP_NUMBER_1=923021735137
STORE_WHATSAPP_NUMBER_2=923021735137
