APP_NAME="OKIRA Store API"
ENVIRONMENT="development"
DEBUG="true"

DATABASE_URL="postgresql://user:pass@host:5432/dbname"
TEST_DATABASE_URL="sqlite:///./test_dababycare.db"

SECRET_KEY="your-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
REFRESH_TOKEN_EXPIRE_DAYS="7"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://okira-backend.vercel.app/api/v1/auth/google/callback"

CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://okira.vercel.app"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
FROM_EMAIL="your-email@gmail.com"
FROM_NAME="OKIRA"
ADMIN_EMAIL="your-email@gmail.com"

BANK_ACCOUNT_TITLE="Your Name"
BANK_NAME="Your Bank"
BANK_ACCOUNT_NUMBER="123456789"
BANK_IBAN="PK00..."

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
